{
  "appId": "com.yourname.hive",
  "appName": "HIVE",
  "webDir": "www",
  "backgroundColor": "#0A0A10",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0A0A10",
    "scrollEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#0A0A10",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "none",
      "style": "dark",
      "resizeOnFullScreen": false
    },
    "LocalNotifications": {
      "iconColor": "#FF5C7A"
    }
  }
}